{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operus-web",
  "routes": [
    { "pattern": "operus.clubemkt.digital", "custom_domain": true },
    { "pattern": "operus.clubemkt.online", "custom_domain": true }
  ],
  "account_id": "cb27e1a67198789eb42d11ab90737652",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Operus Surgical Suite",
    "NEXT_PUBLIC_APP_URL": "https://operus.clubemkt.digital",
    "NEXT_PUBLIC_SUPABASE_URL": "https://xnrdqvxktuwucukohbzm.supabase.co"
  }
}
